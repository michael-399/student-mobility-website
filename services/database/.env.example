# Copy to .env for local (non-Docker) runs.

# Signs the session cookie, which IS the authentication token.
# Generate a real one before deploying: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-secret-key

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mobility_flask

# Where uploaded Learning Agreements and transcripts are written.
UPLOAD_DIR=uploads

# Browser origins allowed to call the API with the session cookie.
# Comma-separated; a wildcard is not usable with credentials.
CORS_ORIGINS=http://localhost:4200

# Cookie flags. Set SESSION_COOKIE_SECURE=true whenever the API is served
# over HTTPS. A front-end on a different origin needs SameSite=None, which
# browsers only honour together with Secure.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
